@page "/sensors"
@implements IDisposable
@inject HttpClient Http
@inject ApiClient Api
@inject AppState State
@using System.Globalization

<PageTitle>Sensor Data Ingestion - Smart-X</PageTitle>

<div class="page-header">
    <h1>Sensor Data Ingestion &amp; Telemetry</h1>
    <p>Register devices, ingest telemetry, and monitor readings with proactive anomaly highlighting.</p>
</div>

@if (!string.IsNullOrEmpty(loadError))
{
    <p class="status-message error">@loadError</p>
}

<div class="card">
    <h2>Register a Sensor</h2>
    <EditForm Model="@newSensor" OnValidSubmit="RegisterSensorAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-grid">
            <div class="form-row">
                <label>Device MAC / Unique ID</label>
                <InputText @bind-Value="newSensor.DeviceId" placeholder="e.g. AA:BB:CC:DD:EE:01" />
            </div>

            <div class="form-row">
                <label>Friendly Name (optional)</label>
                <InputText @bind-Value="newSensor.FriendlyName" placeholder="e.g. Pump C" />
            </div>

            <div class="form-row">
                <label>Deployment Location</label>
                <InputText @bind-Value="newSensor.DeploymentLocation" placeholder="e.g. Greenhouse 2, Zone A, Node 5" />
            </div>

            <div class="form-row">
                <label>Sensor Category</label>
                <InputSelect @bind-Value="newSensor.Category">
                    <option value="@SensorCategory.Environmental">Environmental</option>
                    <option value="@SensorCategory.PowerConsumption">Power Consumption</option>
                    <option value="@SensorCategory.Actuator">Actuator</option>
                </InputSelect>
            </div>
        </div>

        <button type="submit" class="btn-primary" disabled="@isRegistering">
            @(isRegistering ? "Registering..." : "Register Sensor")
        </button>
    </EditForm>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <p class="status-message @(statusIsError ? "error" : "success")">@statusMessage</p>
    }
</div>

<div class="card">
    <h2>Registered Sensors</h2>

    @if (sensors is null)
    {
        <p class="muted">Loading...</p>
    }
    else if (sensors.Count == 0)
    {
        <p class="muted">No sensors registered yet.</p>
    }
    else
    {
        <table class="sensor-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Device ID</th>
                    <th>Location</th>
                    <th>Category</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var sensor in sensors)
                {
                    <tr>
                        <td>@(sensor.FriendlyName ?? "-")</td>
                        <td class="mono">@sensor.DeviceId</td>
                        <td>@sensor.DeploymentLocation</td>
                        <td><span class="category-pill">@sensor.Category</span></td>
                    </tr>
                }
            </tbody>
        </table>

        <h3 class="section-label">Live Status</h3>
        <div class="status-grid">
            @foreach (var sensor in sensors)
            {
                var status = SensorStatus(sensor);
                <div class="status-badge @status">
                    <strong>@sensor.DisplayName</strong>
                    <span>@SensorStatusLabel(status)</span>
                </div>
            }
        </div>
    }
</div>

<div class="card">
    <h2>Deployment Hierarchy</h2>
    <p class="hint">Every sensor's location is parsed into a Facility → Zone → Node tree, validated recursively on registration and rolled up recursively here.</p>

    @if (zones is null)
    {
        <p class="muted">Loading...</p>
    }
    else
    {
        <ul class="zone-tree">
            <ZoneNode Node="zones" />
        </ul>
    }
</div>

<div class="card">
    <h2>Submit Telemetry Reading</h2>
    <div class="form-grid">
        <div class="form-row">
            <label>Sensor</label>
            <select @bind="selectedDeviceId">
                <option value="">-- select a sensor --</option>
                @if (sensors is not null)
                {
                    @foreach (var sensor in sensors)
                    {
                        <option value="@sensor.DeviceId">@sensor.DisplayName - @sensor.DeviceId (@sensor.Category)</option>
                    }
                }
            </select>
        </div>

        <div class="form-row">
            <label>Value</label>
            <input @bind="telemetryValueInput" placeholder="decimal / whole number / true-false" />
        </div>
    </div>

    <button class="btn-primary" @onclick="SubmitTelemetryAsync" disabled="@isSubmittingTelemetry">
        @(isSubmittingTelemetry ? "Submitting..." : "Submit Reading")
    </button>

    @if (!string.IsNullOrEmpty(telemetryStatusMessage))
    {
        <p class="status-message @(telemetryStatusIsError ? "error" : "success")">@telemetryStatusMessage</p>
    }
</div>

<div class="card">
    <h2>Live Telemetry Readings</h2>
    <p class="legend"><span class="legend-swatch anomaly"></span> Highlighted rows are outside the safe range or show a sudden spike.</p>

    @if (dashboard is null)
    {
        <p class="muted">Loading...</p>
    }
    else
    {
        <h3 class="section-label">Environmental</h3>
        <table class="sensor-table">
            <thead><tr><th>Device</th><th>Zone</th><th>Value</th><th>Time</th></tr></thead>
            <tbody>
                @foreach (var reading in dashboard.Environmental.OrderByDescending(r => r.Timestamp))
                {
                    <tr class="@(IsEnvironmentalAnomaly(reading.Value) ? "anomaly-row" : "")">
                        <td class="mono">@reading.DeviceId</td>
                        <td>@reading.Zone</td>
                        <td>@reading.Value @(IsEnvironmentalAnomaly(reading.Value) ? "⚠" : "")</td>
                        <td class="mono">@reading.Timestamp.ToString("HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>

        <h3 class="section-label">Power Consumption</h3>
        <table class="sensor-table">
            <thead><tr><th>Device</th><th>Zone</th><th>Watts</th><th>Time</th></tr></thead>
            <tbody>
                @foreach (var reading in dashboard.Power.OrderByDescending(r => r.Timestamp))
                {
                    <tr class="@(IsPowerSpike(reading) ? "anomaly-row" : "")">
                        <td class="mono">@reading.DeviceId</td>
                        <td>@reading.Zone</td>
                        <td>@reading.Value @(IsPowerSpike(reading) ? "⚠" : "")</td>
                        <td class="mono">@reading.Timestamp.ToString("HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>

        <h3 class="section-label">Actuator States</h3>
        <table class="sensor-table">
            <thead><tr><th>Device</th><th>Zone</th><th>State</th><th>Time</th></tr></thead>
            <tbody>
                @foreach (var reading in dashboard.Actuator.OrderByDescending(r => r.Timestamp))
                {
                    <tr>
                        <td class="mono">@reading.DeviceId</td>
                        <td>@reading.Zone</td>
                        <td><span class="state-pill @(reading.Value ? "on" : "off")">@(reading.Value ? "ON" : "OFF")</span></td>
                        <td class="mono">@reading.Timestamp.ToString("HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<div class="card">
    <h2>Attach a File to a Sensor</h2>
    <p class="hint">Attach a device configuration file, deployment photo, or hardware log to a registered sensor.</p>

    <div class="form-grid">
        <div class="form-row">
            <label>Sensor</label>
            <select @bind="uploadDeviceId" @bind:after="LoadAttachedFilesAsync">
                <option value="">-- select a sensor --</option>
                @if (sensors is not null)
                {
                    @foreach (var sensor in sensors)
                    {
                        <option value="@sensor.DeviceId">@sensor.DisplayName - @sensor.DeviceId</option>
                    }
                }
            </select>
        </div>

        <div class="form-row">
            <label>File</label>
            <InputFile OnChange="OnFileSelected" />
        </div>
    </div>

    <button class="btn-primary" @onclick="UploadFileAsync" disabled="@(isUploading || selectedFile is null)">
        @(isUploading ? "Uploading..." : "Upload File")
    </button>

    @if (!string.IsNullOrEmpty(uploadStatusMessage))
    {
        <p class="status-message @(uploadStatusIsError ? "error" : "success")">@uploadStatusMessage</p>
    }

    @if (!string.IsNullOrWhiteSpace(uploadDeviceId) && attachedFiles is not null)
    {
        <h3 class="section-label">Files attached to @uploadDeviceId</h3>
        @if (attachedFiles.Count == 0)
        {
            <p class="muted">No files attached yet.</p>
        }
        else
        {
            <ul class="file-list">
                @foreach (var fileName in attachedFiles)
                {
                    <li>@fileName</li>
                }
            </ul>
        }
    }
</div>

@code {
    private static readonly TimeSpan StaleAfter = AnomalyRules.DefaultStaleAfter;
    private const long MaxUploadFileSize = 10 * 1024 * 1024; // 10 MB cap

    private readonly CancellationTokenSource cts = new();

    //Drafts live in AppState so they survive navigating to another pillar and back
    private SensorRegistration newSensor => State.Sensors.NewSensor;
    private string? selectedDeviceId
    {
        get => State.Sensors.TelemetryDeviceId;
        set => State.Sensors.TelemetryDeviceId = value;
    }
    private string telemetryValueInput
    {
        get => State.Sensors.TelemetryValue;
        set => State.Sensors.TelemetryValue = value ?? string.Empty;
    }
    private string? uploadDeviceId
    {
        get => State.Sensors.UploadDeviceId;
        set => State.Sensors.UploadDeviceId = value;
    }

    private List<SensorRegistration>? sensors;
    private ZoneNodeDto? zones;
    private TelemetryDashboardResponse? dashboard;
    private string? loadError;

    private bool isRegistering;
    private string? statusMessage;
    private bool statusIsError;

    private bool isSubmittingTelemetry;
    private string? telemetryStatusMessage;
    private bool telemetryStatusIsError;

    private IBrowserFile? selectedFile;
    private bool isUploading;
    private string? uploadStatusMessage;
    private bool uploadStatusIsError;
    private List<string>? attachedFiles;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
        if (!string.IsNullOrWhiteSpace(uploadDeviceId)) await LoadAttachedFilesAsync();

        _ = PollAsync(cts.Token); //keep the dashboard live
    }

    private async Task PollAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await RefreshAsync();
            }
        }
        catch (OperationCanceledException)
        {
            //page was left
        }
    }

    private async Task RefreshAsync()
    {
        var sensorsResult = await Api.GetSensorsAsync();
        var telemetryResult = await Api.GetTelemetryAsync();
        var zonesResult = await Api.GetZonesAsync();

        if (sensorsResult.Ok) sensors = sensorsResult.Data;
        if (telemetryResult.Ok) dashboard = telemetryResult.Data;
        if (zonesResult.Ok) zones = zonesResult.Data;

        loadError = sensorsResult.Ok && telemetryResult.Ok ? null : (sensorsResult.Error ?? telemetryResult.Error);
        await InvokeAsync(StateHasChanged);
    }

    private async Task RegisterSensorAsync()
    {
        isRegistering = true;
        statusMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/sensors", newSensor);

            if (response.IsSuccessStatusCode)
            {
                statusMessage = $"Sensor '{newSensor.DeviceId}' registered successfully.";
                statusIsError = false;
                State.Sensors.NewSensor = new SensorRegistration();
                await RefreshAsync();
            }
            else
            {
                var error = (await response.Content.ReadAsStringAsync()).Trim('"');
                statusMessage = $"Failed to register sensor: {error}";
                statusIsError = true;
            }
        }
        catch (HttpRequestException)
        {
            statusMessage = "Failed to register sensor: cannot reach the gateway API.";
            statusIsError = true;
        }
        finally
        {
            isRegistering = false;
        }
    }

    private async Task SubmitTelemetryAsync()
    {
        telemetryStatusMessage = null;

        if (string.IsNullOrWhiteSpace(selectedDeviceId))
        {
            telemetryStatusMessage = "Select a sensor first.";
            telemetryStatusIsError = true;
            return;
        }

        var sensor = sensors?.FirstOrDefault(s => s.DeviceId == selectedDeviceId);
        if (sensor is null)
        {
            telemetryStatusMessage = "Selected sensor not found.";
            telemetryStatusIsError = true;
            return;
        }

        string raw = telemetryValueInput.Trim().Replace(',', '.');
        isSubmittingTelemetry = true;
        ApiResult<IngestResponse> result;

        switch (sensor.Category)
        {
            case SensorCategory.Environmental:
                if (!float.TryParse(raw, NumberStyles.Float, CultureInfo.InvariantCulture, out var floatValue))
                {
                    FailTelemetry("Environmental readings must be a decimal number (e.g. 42.5).");
                    return;
                }
                result = await Api.PostEnvironmentalAsync(sensor.DeviceId, floatValue);
                break;

            case SensorCategory.PowerConsumption:
                if (!int.TryParse(raw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var intValue))
                {
                    FailTelemetry("Power readings must be a whole number of watts (e.g. 1500).");
                    return;
                }
                result = await Api.PostPowerAsync(sensor.DeviceId, intValue);
                break;

            case SensorCategory.Actuator:
                if (!bool.TryParse(raw, out var boolValue))
                {
                    FailTelemetry("Actuator readings must be 'true' or 'false'.");
                    return;
                }
                result = await Api.PostActuatorAsync(sensor.DeviceId, boolValue);
                break;

            default:
                FailTelemetry("Unknown sensor category.");
                return;
        }

        if (result.Ok)
        {
            string lane = result.Data is { Lane: "Priority" }
                ? $" Critical reading - priority lane ({result.Data.Reason})."
                : string.Empty;
            telemetryStatusMessage = $"Reading recorded for {sensor.DisplayName}.{lane}";
            telemetryStatusIsError = false;
            telemetryValueInput = string.Empty;
            await RefreshAsync();
        }
        else
        {
            telemetryStatusMessage = $"Failed to submit reading: {result.Error}";
            telemetryStatusIsError = true;
        }

        isSubmittingTelemetry = false;
    }

    private void FailTelemetry(string message)
    {
        telemetryStatusMessage = message;
        telemetryStatusIsError = true;
        isSubmittingTelemetry = false;
    }

    //Proactive Anomaly / Alert Highlighting (thresholds come from the shared AnomalyRules)

    private bool IsEnvironmentalAnomaly(float value) => AnomalyRules.IsEnvironmentalAnomaly(value);

    private bool IsPowerSpike(TelemetryPacket<int> reading)
    {
        if (dashboard is null) return false;

        var previous = dashboard.Power
            .Where(r => r.DeviceId == reading.DeviceId && r.Timestamp < reading.Timestamp)
            .OrderByDescending(r => r.Timestamp)
            .FirstOrDefault();

        if (previous is null) return false;

        //Uses the overloaded '-' operator on NumericTelemetryPacket<int> (current - previous = signed delta in watts)
        return AnomalyRules.IsPowerSpike(
            NumericTelemetryPacket<int>.From(reading),
            NumericTelemetryPacket<int>.From(previous));
    }

    private string SensorStatus(SensorRegistration sensor)
    {
        if (dashboard is null) return "unknown";

        var timestamps = new List<DateTime>();
        timestamps.AddRange(dashboard.Environmental.Where(r => r.DeviceId == sensor.DeviceId).Select(r => r.Timestamp));
        timestamps.AddRange(dashboard.Power.Where(r => r.DeviceId == sensor.DeviceId).Select(r => r.Timestamp));
        timestamps.AddRange(dashboard.Actuator.Where(r => r.DeviceId == sensor.DeviceId).Select(r => r.Timestamp));

        if (timestamps.Count == 0) return "no-data";

        var lastSeen = timestamps.Max();
        return (DateTime.UtcNow - lastSeen) > StaleAfter ? "stale" : "ok";
    }

    private string SensorStatusLabel(string status) => status switch
    {
        "ok" => "Live",
        "stale" => "Stale - check connection",
        "no-data" => "No data received",
        _ => "Unknown"
    };

    //File Upload

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        uploadStatusMessage = null;
    }

    private async Task UploadFileAsync()
    {
        if (string.IsNullOrWhiteSpace(uploadDeviceId))
        {
            uploadStatusMessage = "Select a sensor first.";
            uploadStatusIsError = true;
            return;
        }

        if (selectedFile is null)
        {
            uploadStatusMessage = "Choose a file first.";
            uploadStatusIsError = true;
            return;
        }

        isUploading = true;
        uploadStatusMessage = null;

        try
        {
            using var content = new MultipartFormDataContent();
            var fileStream = selectedFile.OpenReadStream(MaxUploadFileSize);
            var streamContent = new StreamContent(fileStream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                string.IsNullOrEmpty(selectedFile.ContentType) ? "application/octet-stream" : selectedFile.ContentType);
            content.Add(streamContent, "file", selectedFile.Name);

            var response = await Http.PostAsync($"api/sensors/{Uri.EscapeDataString(uploadDeviceId)}/files", content);

            if (response.IsSuccessStatusCode)
            {
                uploadStatusMessage = $"'{selectedFile.Name}' uploaded successfully.";
                uploadStatusIsError = false;
                selectedFile = null;
                await LoadAttachedFilesAsync();
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                uploadStatusMessage = $"Upload failed: {error}";
                uploadStatusIsError = true;
            }
        }
        catch (Exception ex)
        {
            uploadStatusMessage = $"Upload failed: {ex.Message}";
            uploadStatusIsError = true;
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task LoadAttachedFilesAsync()
    {
        attachedFiles = null;
        if (string.IsNullOrWhiteSpace(uploadDeviceId)) return;

        try
        {
            attachedFiles = await Http.GetFromJsonAsync<List<string>>($"api/sensors/{Uri.EscapeDataString(uploadDeviceId)}/files");
        }
        catch (HttpRequestException)
        {
            attachedFiles = new List<string>();
        }
    }

    public void Dispose()
    {
        cts.Cancel(); //not disposed: an in-flight refresh may still read cts.Token after we leave the page
    }
}
