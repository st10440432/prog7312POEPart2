@page "/sensors"
@inject HttpClient Http
@using SmartX.Shared.Models
@using System.Net.Http.Json

<PageTitle>Sensor Data Ingestion - Smart-X</PageTitle>

<h1>Sensor Data Ingestion &amp; Telemetry</h1>

<h2>Register a Sensor</h2>

<EditForm Model="@newSensor" OnValidSubmit="RegisterSensorAsync">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-row">
        <label>Device MAC / Unique ID</label>
        <InputText @bind-Value="newSensor.DeviceId" placeholder="e.g. AA:BB:CC:DD:EE:01" />
    </div>

    <div class="form-row">
        <label>Deployment Location (Room, Zone, Node ID)</label>
        <InputText @bind-Value="newSensor.DeploymentLocation" placeholder="e.g. Greenhouse 2, Zone A, Node 5" />
    </div>

    <div class="form-row">
        <label>Sensor Category</label>
        <InputSelect @bind-Value="newSensor.Category">
            <option value="@SensorCategory.Environmental">Environmental</option>
            <option value="@SensorCategory.PowerConsumption">Power Consumption</option>
            <option value="@SensorCategory.Actuator">Actuator</option>
        </InputSelect>
    </div>

    <button type="submit" class="btn-primary" disabled="@isRegistering">
        @(isRegistering ? "Registering..." : "Register Sensor")
    </button>
</EditForm>

@if (!string.IsNullOrEmpty(statusMessage))
{
    <p class="status-message @(statusIsError ? "error" : "success")">@statusMessage</p>
}

<h2>Registered Sensors</h2>

@if (sensors is null)
{
    <p>Loading...</p>
}
else if (sensors.Count == 0)
{
    <p>No sensors registered yet.</p>
}
else
{
    <table class="sensor-table">
        <thead>
            <tr>
                <th>Device ID</th>
                <th>Location</th>
                <th>Category</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var sensor in sensors)
            {
                <tr>
                    <td>@sensor.DeviceId</td>
                    <td>@sensor.DeploymentLocation</td>
                    <td>@sensor.Category</td>
                </tr>
            }
        </tbody>
    </table>

    <h3>Live Status</h3>
    <div class="status-grid">
        @foreach (var sensor in sensors)
        {
            var status = SensorStatus(sensor);
            <div class="status-badge @status">
                <strong>@sensor.DeviceId</strong>
                <span>@SensorStatusLabel(status)</span>
            </div>
        }
    </div>
}

<hr />

<h2>Submit Telemetry Reading</h2>

<div class="form-row">
    <label>Sensor</label>
    <select @bind="selectedDeviceId">
        <option value="">-- select a sensor --</option>
        @if (sensors is not null)
        {
            @foreach (var sensor in sensors)
            {
                <option value="@sensor.DeviceId">@sensor.DeviceId (@sensor.Category)</option>
            }
        }
    </select>
</div>

<div class="form-row">
    <label>Value</label>
    <input @bind="telemetryValueInput" placeholder="decimal for Environmental, whole number for Power, true/false for Actuator" />
</div>

<button class="btn-primary" @onclick="SubmitTelemetryAsync" disabled="@isSubmittingTelemetry">
    @(isSubmittingTelemetry ? "Submitting..." : "Submit Reading")
</button>

@if (!string.IsNullOrEmpty(telemetryStatusMessage))
{
    <p class="status-message @(telemetryStatusIsError ? "error" : "success")">@telemetryStatusMessage</p>
}

<h2>Live Telemetry Readings</h2>
<p class="legend"><span class="legend-swatch anomaly"></span> Highlighted rows are outside the safe range or show a sudden spike.</p>

@if (dashboard is null)
{
    <p>Loading...</p>
}
else
{
    <h3>Environmental</h3>
    <table class="sensor-table">
        <thead><tr><th>Device</th><th>Zone</th><th>Value</th><th>Time</th></tr></thead>
        <tbody>
            @foreach (var reading in dashboard.Environmental.OrderByDescending(r => r.Timestamp))
            {
                <tr class="@(IsEnvironmentalAnomaly(reading.Value) ? "anomaly-row" : "")">
                    <td>@reading.DeviceId</td>
                    <td>@reading.Zone</td>
                    <td>@reading.Value @(IsEnvironmentalAnomaly(reading.Value) ? "⚠" : "")</td>
                    <td>@reading.Timestamp.ToString("HH:mm:ss")</td>
                </tr>
            }
        </tbody>
    </table>

    <h3>Power Consumption</h3>
    <table class="sensor-table">
        <thead><tr><th>Device</th><th>Zone</th><th>Watts</th><th>Time</th></tr></thead>
        <tbody>
            @foreach (var reading in dashboard.Power.OrderByDescending(r => r.Timestamp))
            {
                <tr class="@(IsPowerSpike(reading) ? "anomaly-row" : "")">
                    <td>@reading.DeviceId</td>
                    <td>@reading.Zone</td>
                    <td>@reading.Value @(IsPowerSpike(reading) ? "⚠" : "")</td>
                    <td>@reading.Timestamp.ToString("HH:mm:ss")</td>
                </tr>
            }
        </tbody>
    </table>

    <h3>Actuator States</h3>
    <table class="sensor-table">
        <thead><tr><th>Device</th><th>Zone</th><th>State</th><th>Time</th></tr></thead>
        <tbody>
            @foreach (var reading in dashboard.Actuator.OrderByDescending(r => r.Timestamp))
            {
                <tr>
                    <td>@reading.DeviceId</td>
                    <td>@reading.Zone</td>
                    <td>@(reading.Value ? "ON" : "OFF")</td>
                    <td>@reading.Timestamp.ToString("HH:mm:ss")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private const float EnvironmentalLowThreshold = 15f;
    private const float EnvironmentalHighThreshold = 85f;
    private const int PowerSpikeThresholdWatts = 500;
    private static readonly TimeSpan StaleAfter = TimeSpan.FromSeconds(60);

    private SensorRegistration newSensor = new();
    private List<SensorRegistration>? sensors;
    private bool isRegistering;
    private string? statusMessage;
    private bool statusIsError;

    private string? selectedDeviceId;
    private string telemetryValueInput = string.Empty;
    private bool isSubmittingTelemetry;
    private string? telemetryStatusMessage;
    private bool telemetryStatusIsError;
    private TelemetryDashboardResponse? dashboard;

    protected override async Task OnInitializedAsync()
    {
        await LoadSensorsAsync();
        await LoadTelemetryAsync();
    }

    private async Task LoadSensorsAsync()
    {
        sensors = await Http.GetFromJsonAsync<List<SensorRegistration>>("api/sensors");
    }

    private async Task LoadTelemetryAsync()
    {
        dashboard = await Http.GetFromJsonAsync<TelemetryDashboardResponse>("api/telemetry");
    }

    private async Task RegisterSensorAsync()
    {
        isRegistering = true;
        statusMessage = null;

        var response = await Http.PostAsJsonAsync("api/sensors", newSensor);

        if (response.IsSuccessStatusCode)
        {
            statusMessage = $"Sensor '{newSensor.DeviceId}' registered successfully.";
            statusIsError = false;
            newSensor = new SensorRegistration();
            await LoadSensorsAsync();
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            statusMessage = $"Failed to register sensor: {error}";
            statusIsError = true;
        }

        isRegistering = false;
    }

    private async Task SubmitTelemetryAsync()
    {
        telemetryStatusMessage = null;

        if (string.IsNullOrWhiteSpace(selectedDeviceId))
        {
            telemetryStatusMessage = "Select a sensor first.";
            telemetryStatusIsError = true;
            return;
        }

        var sensor = sensors?.FirstOrDefault(s => s.DeviceId == selectedDeviceId);
        if (sensor is null)
        {
            telemetryStatusMessage = "Selected sensor not found.";
            telemetryStatusIsError = true;
            return;
        }

        isSubmittingTelemetry = true;
        HttpResponseMessage response;

        switch (sensor.Category)
        {
            case SensorCategory.Environmental:
                if (!float.TryParse(telemetryValueInput, out var floatValue))
                {
                    telemetryStatusMessage = "Environmental readings must be a decimal number (e.g. 42.5).";
                    telemetryStatusIsError = true;
                    isSubmittingTelemetry = false;
                    return;
                }
                response = await Http.PostAsJsonAsync("api/telemetry/environmental",
                    new TelemetryIngestRequest<float>(sensor.DeviceId, floatValue));
                break;

            case SensorCategory.PowerConsumption:
                if (!int.TryParse(telemetryValueInput, out var intValue))
                {
                    telemetryStatusMessage = "Power readings must be a whole number of watts (e.g. 1500).";
                    telemetryStatusIsError = true;
                    isSubmittingTelemetry = false;
                    return;
                }
                response = await Http.PostAsJsonAsync("api/telemetry/power",
                    new TelemetryIngestRequest<int>(sensor.DeviceId, intValue));
                break;

            case SensorCategory.Actuator:
                if (!bool.TryParse(telemetryValueInput, out var boolValue))
                {
                    telemetryStatusMessage = "Actuator readings must be 'true' or 'false'.";
                    telemetryStatusIsError = true;
                    isSubmittingTelemetry = false;
                    return;
                }
                response = await Http.PostAsJsonAsync("api/telemetry/actuator",
                    new TelemetryIngestRequest<bool>(sensor.DeviceId, boolValue));
                break;

            default:
                telemetryStatusMessage = "Unknown sensor category.";
                telemetryStatusIsError = true;
                isSubmittingTelemetry = false;
                return;
        }

        if (response.IsSuccessStatusCode)
        {
            telemetryStatusMessage = $"Reading recorded for {sensor.DeviceId}.";
            telemetryStatusIsError = false;
            telemetryValueInput = string.Empty;
            await LoadTelemetryAsync();
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            telemetryStatusMessage = $"Failed to submit reading: {error}";
            telemetryStatusIsError = true;
        }

        isSubmittingTelemetry = false;
    }

    //Proactive Anomaly / Alert Highlighting

    private bool IsEnvironmentalAnomaly(float value) =>
        value < EnvironmentalLowThreshold || value > EnvironmentalHighThreshold;

    private bool IsPowerSpike(TelemetryPacket<int> reading)
    {
        if (dashboard is null) return false;

        var previous = dashboard.Power
            .Where(r => r.DeviceId == reading.DeviceId && r.Timestamp < reading.Timestamp)
            .OrderByDescending(r => r.Timestamp)
            .FirstOrDefault();

        if (previous is null) return false;

        var currentMeter = new PowerMeterReading(reading.DeviceId, reading.Value);
        var previousMeter = new PowerMeterReading(previous.DeviceId, previous.Value);
        double delta = currentMeter - previousMeter;

        return Math.Abs(delta) > PowerSpikeThresholdWatts;
    }

    private string SensorStatus(SensorRegistration sensor)
    {
        if (dashboard is null) return "unknown";

        var timestamps = new List<DateTime>();
        timestamps.AddRange(dashboard.Environmental.Where(r => r.DeviceId == sensor.DeviceId).Select(r => r.Timestamp));
        timestamps.AddRange(dashboard.Power.Where(r => r.DeviceId == sensor.DeviceId).Select(r => r.Timestamp));
        timestamps.AddRange(dashboard.Actuator.Where(r => r.DeviceId == sensor.DeviceId).Select(r => r.Timestamp));

        if (timestamps.Count == 0) return "no-data";

        var lastSeen = timestamps.Max();
        return (DateTime.UtcNow - lastSeen) > StaleAfter ? "stale" : "ok";
    }

    private string SensorStatusLabel(string status) => status switch
    {
        "ok" => "Live",
        "stale" => "Stale - check connection",
        "no-data" => "No data received",
        _ => "Unknown"
    };
}